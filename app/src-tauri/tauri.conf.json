{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceRunaCore",
  "version": "1.1.0",
  "identifier": "com.waflyaa.voicerunacore",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "VoiceRunaCore",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Waflyaa",
    "shortDescription": "VoiceRunaCore — голосовой помощник для Windows",
    "longDescription": "Голосовой помощник VoiceRunaCore: слушает микрофон, распознаёт команды, запускает программы и отвечает голосом. Имя ассистента и слово-будильник настраиваются. Работает локально, сайдкар слушает только 127.0.0.1.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/sidecar/": "sidecar/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
